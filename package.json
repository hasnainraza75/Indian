{
  "name": "indian-open-world-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Indian Open World 3D - Complete GTA-style open world action driving Android game built with Three.js, React, TypeScript, Vite, and Capacitor.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:android": "tsc && vite build && node scripts/sync-android-assets.mjs",
    "preview": "vite preview",
    "cap:sync": "npm run build:android && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/screen-orientation": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
